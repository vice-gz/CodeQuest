# Copia este archivo como ".env" y rellena los valores desde
# Supabase -> Project Settings -> API.
# SOLO la clave "anon" / "publishable". NUNCA pongas aquí la service_role.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-clave-anon-publica

# Opcional: si lo rellenas, el registro solo acepta correos de ese dominio.
# Déjalo vacío para aceptar cualquier correo (útil mientras pruebas).
VITE_DOMINIO_INSTITUCIONAL=
